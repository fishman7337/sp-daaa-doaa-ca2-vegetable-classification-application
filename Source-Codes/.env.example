# Backend
# Copy this file to .env for local development. Replace all placeholder secrets.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_MINUTES=120
DATABASE_PATH=./db/app.db
MODEL_SERVICE_URL=http://127.0.0.1:8000
MODEL_SERVICE_TIMEOUT_SEC=30
MODELS_ROOT=./models
UPLOAD_DIR=./backend/uploads
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
CAPTCHA_ENABLED=true
CAPTCHA_TTL_SEC=300
CAPTCHA_LENGTH=5
CAPTCHA_IMAGE_WIDTH=540
CAPTCHA_IMAGE_HEIGHT=180
CAPTCHA_DEV_MODE=false
OTP_ENABLED=true
OTP_LENGTH=6
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_DEV_MODE=true
PASSWORD_RESET_TTL_SEC=1800
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VeggieAI Security
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SECURITY_HEADERS_ENABLED=true
ENABLE_HSTS=true
HSTS_MAX_AGE=31536000
FORCE_HTTPS=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMISSIONS_POLICY=camera=(self), microphone=(), geolocation=()
CSP_POLICY=default-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: http:

# Veggie model selection + deployed TensorFlow Serving endpoints.
# Local model_service is used by /api/predict. The /api/veggie/predict route uses
# these VegNet endpoints unless VEGNET_REMOTE_ENABLED=false.
VEGGIE_DEFAULT_MODEL=vegnet-23
VEGNET_REMOTE_ENABLED=true
VEGNET_REMOTE_TIMEOUT_SEC=45
VEGNET_REMOTE_RETRIES=4
VEGNET_23_URL=https://ca2-daaa2b02-p2415691-gohkunming.onrender.com/v1/models/vegnet-23
VEGNET_101_URL=https://ca2-daaa2b02-p2415691-gohkunming.onrender.com/v1/models/vegnet-101
VEGNET_23_RESAMPLE=nearest
VEGNET_101_RESAMPLE=bicubic

# OpenAI chatbot
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SEC=20

# Roboflow camera object detection
# Set either ROBOFLOW_MODEL_ID (hosted model mode) or
# ROBOFLOW_WORKSPACE + ROBOFLOW_WORKFLOW_ID (workflow mode).
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_BASE_URL=https://detect.roboflow.com
ROBOFLOW_TIMEOUT_SEC=10
ROBOFLOW_CONFIDENCE_THRESHOLD=0.35
ROBOFLOW_WEBRTC_API_URL=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW_ID=
ROBOFLOW_WORKFLOW_IMAGE_INPUT=image
ROBOFLOW_WEBRTC_PLAN=webrtc-gpu-medium
ROBOFLOW_WEBRTC_REGION=ap
ROBOFLOW_WEBRTC_TIMEOUT_SEC=600
ROBOFLOW_WEBCAM_WIDTH=1280
ROBOFLOW_WEBCAM_HEIGHT=720

# Model service
MODEL_MODE=auto
DEFAULT_TOP_K=3

# python main.py local runner
MODEL_SERVICE_PORT=8000
BACKEND_PORT=5000
LOCALHOST_ONLY=true
MODEL_SERVICE_HOST=127.0.0.1
BACKEND_HOST=127.0.0.1
